IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// A scalar led_n drives LED0. A vector led_n[5:0] drives LED0 through LED5.
IO_LOC "led_n" 15;
IO_PORT "led_n" IO_TYPE=LVCMOS33;
IO_LOC "led_n[0]" 15;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[1]" 16;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[2]" 17;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[3]" 18;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[4]" 19;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33;

// Serial data input of the separate WS2812 RGB LED.
IO_LOC "rgb_data" 79;
IO_PORT "rgb_data" IO_TYPE=LVCMOS33;

// Component side up, USB-C at the top: S1 on the left, S2 on the right.
// The board pulls each input low; pressing the button connects it to 3.3 V.
IO_LOC "l_btn" 88;
IO_PORT "l_btn" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "r_btn" 87;
IO_PORT "r_btn" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
